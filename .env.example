# --- Client-side Asgardeo config (Asgardeo React SDK — these are public,
# prefixed NEXT_PUBLIC_ so the browser can use them; no secret needed since
# the SPA flow uses PKCE, not a client secret) ---
NEXT_PUBLIC_ASGARDEO_CLIENT_ID=
NEXT_PUBLIC_ASGARDEO_BASE_URL=https://api.asgardeo.io/t/<your-org>
NEXT_PUBLIC_ASGARDEO_SIGN_IN_REDIRECT_URL=https://<your-choreo-app-url>
NEXT_PUBLIC_ASGARDEO_SIGN_OUT_REDIRECT_URL=https://<your-choreo-app-url>

# --- Server-side token verification (used by API routes, lib/auth-server.js) ---
ASGARDEO_ISSUER=https://api.asgardeo.io/t/<your-org>/oauth2/token

# --- GitHub — fine-grained PAT or GitHub App token with repo read access ---
GITHUB_TOKEN=
